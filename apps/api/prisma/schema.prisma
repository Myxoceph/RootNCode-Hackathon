/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model app_user {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nickname              String
  role                  String              @default("visitor")
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  banned_at             DateTime?           @db.Timestamptz(6)
  username              String?             @unique
  password_hash         String?
  reviewedContributions contribution[]      @relation("contribution_reviewed_byToapp_user")
  contributions         contribution[]      @relation("contribution_user_idToapp_user")
  redemption            redemption[]
  user_achievement      user_achievement[]
  sessions              user_session[]
  visit                 visit[]
  chat_conversation     chat_conversation[]
  user_route            user_route[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
