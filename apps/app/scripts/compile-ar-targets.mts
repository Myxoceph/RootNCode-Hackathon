/**
 * Compiles the AR prototype's image targets into MindAR's `.mind` format (Y5).
 *
 *   npm run ar:targets --workspace @vagabonds/app
 *
 * Needs Chrome (see ./mindar-compiler.mts). Writes src/ar/test-targets.generated.ts:
 * the `.mind` file as base64, so the tracker page can load it without fetching.
 * The order of TARGETS is the target index.
 *
 * The dataset's own targets are compiled by data/tools/compile_ar_targets.mts; these
 * test targets stay as the fallback when an asset has none (src/ar/inscription-targets.ts).
 */
import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

import { MINDAR_VERSION } from "../src/ar/mindar";
import { compileMindTargets } from "./mindar-compiler.mts";

const DIR = fileURLToPath(new URL("../src/ar/test-targets/", import.meta.url));
const OUT = fileURLToPath(new URL("../src/ar/test-targets.generated.ts", import.meta.url));

const TARGETS = [
  { file: "ulucami-portal.jpg", label: "Ulucami kapı kitabesi" },
  { file: "ulucami-panel.jpg", label: "Ulucami hat levhası" },
];

const images = TARGETS.map(({ file }) => `data:image/jpeg;base64,${readFileSync(join(DIR, file)).toString("base64")}`);
const mind = (await compileMindTargets(images)).toString("base64");

writeFileSync(
  OUT,
  `// Generated by scripts/compile-ar-targets.mts. Do not edit; run \`npm run ar:targets\`.
// Sources and licenses: src/ar/test-targets/README.md

/** Labels by target index, in the order the targets were compiled. */
export const testTargetLabels = ${JSON.stringify(TARGETS.map((target) => target.label))};

/** MindAR ${MINDAR_VERSION} \`.mind\` file, base64. */
export const testTargetsMind =
  "${mind}";
`,
);
console.log(`Wrote ${OUT} (${TARGETS.length} targets, ${Math.round((mind.length * 3) / 4 / 1024)} KB)`);
