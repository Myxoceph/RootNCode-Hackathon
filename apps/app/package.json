{
  "name": "@vagabonds/app",
  "version": "0.1.0",
  "private": true,
  "description": "Vagabonds client: one Expo codebase for iOS, Android and Web.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "android:apk": "export EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL:-https://vagabonds.allbytech.com/api}; expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=${ANDROID_ARCHS:-arm64-v8a}",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export": "expo export --platform all",
    "fixtures": "tsx scripts/capture-fixtures.mts",
    "ar:targets": "tsx scripts/compile-ar-targets.mts",
    "audio:stand-ins": "tsx scripts/render-capsule-sounds.mts",
    "vendor": "tsx scripts/vendor-web-libs.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/marcellus": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@vagabonds/contracts": "^0.3.0",
    "@vagabonds/ui": "^0.1.0",
    "expo": "~57.0.30",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.27",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
