/**
 * Bundles the browser libraries the WebView pages need into the app (Y12):
 * MindAR for the AR tracker, MapLibre GL JS for the map. The pages then work
 * without reaching jsDelivr, which a slow or filtered network may block.
 *
 *   npm run vendor --workspace @vagabonds/app
 *
 * Downloads the pinned versions from npm (mind-ar is not a dependency: it pulls in
 * native packages such as `canvas` that would slow everyone's `npm install`),
 * bundles MindAR's ES module chunks into one classic script with esbuild, and writes
 * src/vendor/{mindar,maplibre}.generated.ts and their licenses to src/vendor/LICENSES.md.
 * Run again when a version changes.
 */
import { execFileSync } from "node:child_process";
import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

import { build } from "esbuild";

import { MINDAR_VERSION } from "../src/ar/mindar";
import { MAPLIBRE_VERSION } from "../src/map/maplibre-page";

const OUT_DIR = fileURLToPath(new URL("../src/vendor/", import.meta.url));

/** Downloads and unpacks one npm package; returns the unpacked folder. */
function fetchPackage(spec: string, into: string): string {
  const tarball = execFileSync("npm", ["pack", spec, "--silent", "--pack-destination", into], { encoding: "utf8" }).trim();
  const folder = join(into, spec.replace(/[@/]/g, "_"));
  execFileSync("mkdir", ["-p", folder]);
  execFileSync("tar", ["-xzf", join(into, tarball), "-C", folder]);
  return join(folder, "package");
}

/**
 * The text goes inside a <script> or <style> element of an HTML string, where
 * "</script" or "</style" would end it early. Escaping the slash keeps the code the same.
 */
function forInlineTag(code: string, tag: "script" | "style"): string {
  return code.replaceAll(`</${tag}`, `<\\/${tag}`);
}

function writeModule(file: string, header: string, exports: Record<string, string>): void {
  const body = Object.entries(exports)
    .map(([name, value]) => `export const ${name} =\n  ${JSON.stringify(value)};\n`)
    .join("\n");
  const path = join(OUT_DIR, file);
  writeFileSync(path, `// Generated by scripts/vendor-web-libs.mts. Do not edit; run \`npm run vendor\`.\n${header}\n${body}`);
  console.log(`Wrote ${path} (${Math.round(Buffer.byteLength(body) / 1024)} KB)`);
}

const work = mkdtempSync(join(tmpdir(), "vendor-web-libs-"));
try {
  const mindar = fetchPackage(`mind-ar@${MINDAR_VERSION}`, work);
  // The entry sets window.MINDAR.IMAGE; its chunks import each other, so bundle them into one file.
  const bundled = await build({
    entryPoints: [join(mindar, "dist/mindar-image.prod.js")],
    bundle: true,
    format: "iife",
    platform: "browser",
    legalComments: "none",
    // TensorFlow.js inside MindAR requires these only when it runs under Node.js.
    external: ["node-fetch", "util", "string_decoder"],
    write: false,
  });
  writeModule(
    "mindar.generated.ts",
    `// MindAR ${MINDAR_VERSION} image tracking (MIT, https://github.com/hiukim/mind-ar-js); sets window.MINDAR.IMAGE.`,
    { mindarScript: forInlineTag(bundled.outputFiles[0]!.text, "script") },
  );

  const maplibre = fetchPackage(`maplibre-gl@${MAPLIBRE_VERSION}`, work);
  writeModule(
    "maplibre.generated.ts",
    `// MapLibre GL JS ${MAPLIBRE_VERSION} (BSD-3-Clause, https://github.com/maplibre/maplibre-gl-js); sets window.maplibregl.`,
    {
      maplibreScript: forInlineTag(readFileSync(join(maplibre, "dist/maplibre-gl.js"), "utf8"), "script"),
      maplibreCss: forInlineTag(readFileSync(join(maplibre, "dist/maplibre-gl.css"), "utf8"), "style"),
    },
  );

  const license = (folder: string) => {
    const file = ["LICENSE", "LICENSE.txt", "LICENSE.md"].map((name) => join(folder, name)).find(existsSync);
    if (!file) throw new Error(`No license file in ${folder}`);
    return readFileSync(file, "utf8").trim();
  };
  writeFileSync(
    join(OUT_DIR, "LICENSES.md"),
    `# Licenses of the bundled libraries\n\nGenerated by \`scripts/vendor-web-libs.mts\`.\n\n` +
      `## MindAR ${MINDAR_VERSION}\n\n\`\`\`\n${license(mindar)}\n\`\`\`\n\n` +
      `## MapLibre GL JS ${MAPLIBRE_VERSION}\n\n\`\`\`\n${license(maplibre)}\n\`\`\`\n`,
  );
} finally {
  rmSync(work, { recursive: true, force: true });
}
