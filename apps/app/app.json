{
  "expo": {
    "name": "Vagabonds",
    "slug": "vagabonds",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/images/splash-blank.png",
        "backgroundColor": "#0D1420"
      }
    },
    "scheme": "vagabonds",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.vagabonds.app"
    },
    "android": {
      "package": "com.vagabonds.app",
      "adaptiveIcon": {
        "backgroundColor": "#151B28",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Kitabeleri tanımak, ziyaretini mühürlemek ve Taşa Sor ile bir detayı sormak için kamera kullanılır. Taşa Sor'da çektiğin fotoğraf yalnızca açıklanmak için gönderilir, saklanmaz; diğerlerinde görüntü cihazdan çıkmaz.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bir eserin yanında olduğunu doğrulamak ve ziyaretini mühürlemek için konumunu kullanıyoruz."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#0D1420",
            "image": "./assets/images/splash-blank.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Rehber'e sesli soru sorabilmen için mikrofon kullanılır. Kayıt yalnızca yazıya çevrilir, saklanmaz.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Anı Defteri'ne eklemek için seçtiğin fotoğraflara erişilir. Bu fotoğrafları yalnızca sen görebilirsin.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
