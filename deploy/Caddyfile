# SITE_ADDRESS: a domain (e.g. vagabonds.example.com) gets automatic HTTPS from Let's Encrypt;
# ":80" serves plain HTTP on any host name or IP (no certificate).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
		-Server
	}

	# API: /api/assets → api:3000/assets. Swagger UI at /api/docs.
	handle_path /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:3000
	}

	# Web app (Expo static export). Hashed bundles are cached for a year.
	handle {
		root * /srv/web
		@hashed path /_expo/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}
