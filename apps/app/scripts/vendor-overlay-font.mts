/**
 * Inlines the app's own font into the AR tracker page, so the translation drawn over an
 * inscription is set in Marcellus, the app's heading font (the Kamera tab's title), not the WebView's system font.
 *
 *   npm run vendor --workspace @vagabonds/app
 *
 * Reads the font from @expo-google-fonts/marcellus (already a dependency; SIL Open Font
 * License) and writes src/vendor/overlay-font.generated.ts as base64. Run again when the
 * package changes.
 */
import { readFileSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";
import { fileURLToPath } from "node:url";

const require = createRequire(import.meta.url);
const font = require.resolve("@expo-google-fonts/marcellus/400Regular/Marcellus_400Regular.ttf");
const out = fileURLToPath(new URL("../src/vendor/overlay-font.generated.ts", import.meta.url));
const base64 = readFileSync(font).toString("base64");
writeFileSync(
  out,
  `// Generated by scripts/vendor-overlay-font.mts. Do not edit; run \`npm run vendor\`.\n` +
    `// Marcellus Regular (SIL Open Font License 1.1, https://fonts.google.com/specimen/Marcellus), as base64 TrueType.\n` +
    `export const overlayFontBase64 =\n  ${JSON.stringify(base64)};\n`,
);
console.log(`Wrote ${out} (${Math.round(base64.length / 1024)} KB)`);
