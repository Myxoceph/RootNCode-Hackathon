# Local development database (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://vagabonds:vagabonds@localhost:5432/vagabonds"

# Optional (defaults shown)
# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info
# CORS_ORIGINS=http://localhost:8081   # comma-separated; Expo web dev server by default
# MEDIA_BASE_URL=https://media.allbytech.com   # media Worker in front of the R2 bucket
# ASSET_VISIBILITY=published          # or "preview": also serves in_review records (never drafts)
# TRUST_PROXY=false                   # behind a proxy: its IPs/CIDRs, or "uniquelocal" (private networks)
# RATE_LIMIT_MAX=120                  # requests per minute per client IP; 0 turns the limit off
# OPEN_METEO_URL=https://api.open-meteo.com  # current weather (no key); empty turns weather off
# AI assistant (POST /chat): an OpenAI-compatible endpoint and model; empty turns it off
# ASSISTANT_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1   # EVREN; Ollama: http://localhost:11434/v1
# ASSISTANT_MODEL=qwen3.8-flash-next   # Ollama: qwen3:8b
# ASSISTANT_API_KEY=                   # EVREN key (docs/deploy.md); keep it out of git
# Sesli Rehber (POST /voice/*) on the same provider; empty turns voice off
# VOICE_ASR_MODEL=qwen3-asr-1.7b      # EVREN speech-to-text
# VOICE_TTS_MODEL=voxcpm2             # EVREN text-to-speech
# VISION_MODEL=qwen3-vl-30b           # EVREN vision, for Taşa Sor
# Konya transit pilot: OpenTripPlanner (deploy/otp/prepare.sh); empty turns GET /transit/plan off
# OTP_URL=http://localhost:8090
# Photos uploaded from the panel: an R2 token allowed to write only this bucket; empty turns uploads off
# MEDIA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MEDIA_BUCKET=kok-kod-media-public
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# DEMO_UNLOCK=true                    # "Kilidi aç" and the seal work away from the sites; "false" once the photo is required
