  reward      reward      @relation(fields: [reward_code], references: [code], onDelete: Cascade, onUpdate: NoAction)

  @@unique([reward_code, code])
}

/// The partial unique index chat_conversation_open_idx (one open conversation per page) lives only in the migration.
model chat_conversation {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String         @db.Uuid
  asset_id    String?
  title       String
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @db.Timestamptz(6)
  archived_at DateTime?      @db.Timestamptz(6)
  app_user    app_user       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
