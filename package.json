{
  "name": "vagabonds",
  "version": "0.1.0",
  "private": true,
  "description": "Vakıf eserlerini çok duyulu ve kapsayıcı bir dijital deneyimle keşfettiren platform (KÖK&KOD Hackathon).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "app": "npm run start --workspace @vagabonds/app",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "contracts:validate": "npm run validate --workspace @vagabonds/contracts",
    "ui:contrast": "npm run contrast --workspace @vagabonds/ui",
    "data:validate": "python3 data/tools/validate.py",
    "data:ar-targets": "tsx data/tools/compile_ar_targets.mts",
    "map:warm": "node deploy/tiles-worker/warm.mjs",
    "db:import": "set -a && . apps/api/.env && set +a && python3 data/tools/import_to_db.py --verify",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  }
}
