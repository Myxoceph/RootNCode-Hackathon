}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_session {
  token_hash String   @id
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "user_session_user_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model photo_upload {
  contribution_id String       @id @db.Uuid
  content_type    String
  bytes           Bytes
  width           Int
  height          Int
  sha256          String
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  contribution    contribution @relation(fields: [contribution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model achievement {
  code             String             @id
  title_tr         String
  title_en         String?
  description_tr   String
  description_en   String?
  badge            String
  points           Int
  rule             Json
  sort_order       Int                @default(1000)
