        "files": {
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "mime": {
                "type": "string",
                "maxLength": 80
              },
              "key": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 400
                  },
                  {
                    "type": "null"
                  }
