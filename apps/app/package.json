{
  "name": "@vagabonds/app",
  "version": "0.1.0",
  "private": true,
  "description": "Vagabonds client: one Expo codebase for iOS, Android and Web.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "android:apk": "export EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL:-https://vagabonds.allbytech.com/api}; expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=${ANDROID_ARCHS:-arm64-v8a}",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export": "expo export --platform all",
    "fixtures": "tsx scripts/capture-fixtures.mts",
    "ar:targets": "tsx scripts/compile-ar-targets.mts",
    "audio:stand-ins": "tsx scripts/render-capsule-sounds.mts",
    "vendor": "tsx scripts/vendor-web-libs.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/marcellus": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@vagabonds/contracts": "^0.3.0",
    "@vagabonds/ui": "^0.1.0",
    "expo": "~58.0.21",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
