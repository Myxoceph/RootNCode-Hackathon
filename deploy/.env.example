# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored; never commit it.

# Required. Use letters and digits only (it goes into a connection URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Domain pointing at the server (gets HTTPS automatically), or ":80" for plain HTTP by IP.
SITE_ADDRESS=:80

# The address people open in the browser; the API allows it for CORS.
PUBLIC_URL=http://localhost

# Public base URL of the media: the media Worker in front of the R2 bucket (no trailing slash, docs/deploy.md).
MEDIA_BASE_URL=https://media.allbytech.com

# Only behind Cloudflare Tunnel, with HTTP_PORT=127.0.0.1:8080 (docs/deploy.md): private_ranges.
# TRUSTED_PROXIES=private_ranges

# Host ports Caddy listens on. Change only for a local trial next to other services.
HTTP_PORT=80
HTTPS_PORT=443

# AI assistant (docs/deploy.md, "AI asistan"): an OpenAI-compatible endpoint and model; empty turns it off.
# EVREN: https://evren-llmapi.ssyz.org.tr/v1 and qwen3.8-flash-next.
# Ollama on this machine: ASSISTANT_BASE_URL=http://host.docker.internal:11434/v1
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
# EVREN key (docs/deploy.md, "AI asistan"); Ollama needs none.
ASSISTANT_API_KEY=
# Sesli Rehber (POST /voice/*) on the assistant's provider. Unset: EVREN's qwen3-asr-1.7b and voxcpm2;
# set them empty (Ollama has no speech models) to turn voice off.
# VOICE_ASR_MODEL=qwen3-asr-1.7b
# VOICE_TTS_MODEL=voxcpm2
# The preflight's own account (`onkontrol`), opened on first use: only accounts ask the assistant.
# Any long random password; a secret, never one of the demo accounts'.
PREFLIGHT_PASSWORD=

# The Oracle server, for deploy/failover.sh on the Mac (docs/deploy.md, "Oracle çökerse"): who to SSH as, and
# the private key's path on this Mac (the key itself stays in ~/.ssh). Not needed on the server.
ORACLE_SSH=
ORACLE_SSH_KEY=
# Where the Mac keeps the server's backups; outside ~/Desktop (macOS keeps background jobs out of it).
MAC_BACKUP_DIR=~/vagabonds-backups

# Cloudflare Tunnel token for serving from a Mac (docs/deploy.md, "Bilgisayardan yayın"): the tunnel
# owner runs `cloudflared tunnel token vagabonds-demo`. A secret; `deploy/demo.sh tunnel` reads it from here.
# TUNNEL_TOKEN=
