/**
 * Compiles the AR prototype's image targets into MindAR's `.mind` format (Y5).
 *
 *   npm run ar:targets --workspace @vagabonds/app
 *
 * MindAR's compiler runs in a browser, so this starts headless Chrome (CHROME_PATH,
 * default: the macOS install) and compiles there. Needs network for jsDelivr.
 *
 * Writes src/ar/test-targets.generated.ts: the `.mind` file as base64, so the tracker
 * page can load it without fetching. The order of TARGETS is the target index.
 */
import { spawn } from "node:child_process";
import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

import { MINDAR_VERSION } from "../src/ar/mindar";

const CHROME = process.env.CHROME_PATH ?? "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome";
const DIR = fileURLToPath(new URL("../src/ar/test-targets/", import.meta.url));
const OUT = fileURLToPath(new URL("../src/ar/test-targets.generated.ts", import.meta.url));
const PORT = 9339;

const TARGETS = [
  { file: "ulucami-portal.jpg", label: "Ulucami kapı kitabesi" },
  { file: "ulucami-panel.jpg", label: "Ulucami hat levhası" },
];

const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

async function pageSocketUrl(): Promise<string> {
  for (let i = 0; i < 40; i++) {
    try {
      const tabs = (await (await fetch(`http://127.0.0.1:${PORT}/json`)).json()) as Array<{ type: string; webSocketDebuggerUrl: string }>;
      const page = tabs.find((tab) => tab.type === "page");
      if (page) return page.webSocketDebuggerUrl;
    } catch {
      // Chrome is still starting.
    }
    await sleep(250);
  }
  throw new Error(`Chrome did not open a debugging port (${CHROME})`);
}

/** Runs `expression` in the page and returns its (awaited) string result. */
async function evaluate(socketUrl: string, expression: string): Promise<string> {
  const socket = new WebSocket(socketUrl);
  await new Promise((resolve, reject) => {
    socket.onopen = resolve;
    socket.onerror = reject;
  });
  const reply = await new Promise<{ result: { result?: { value: string }; exceptionDetails?: unknown } }>((resolve) => {
    socket.onmessage = (message) => resolve(JSON.parse(String(message.data)));
    socket.send(JSON.stringify({ id: 1, method: "Runtime.evaluate", params: { expression, awaitPromise: true, timeout: 600_000 } }));
  });
  socket.close();
  if (reply.result.exceptionDetails) throw new Error(JSON.stringify(reply.result.exceptionDetails).slice(0, 1000));
  return reply.result.result!.value;
}

const images = TARGETS.map(({ file }) => `data:image/jpeg;base64,${readFileSync(join(DIR, file)).toString("base64")}`);
const profile = mkdtempSync(join(tmpdir(), "ar-targets-"));
const chrome = spawn(CHROME, ["--headless=new", `--remote-debugging-port=${PORT}`, `--user-data-dir=${profile}`, "about:blank"], {
  stdio: "ignore",
});

try {
  const mind = await evaluate(
    await pageSocketUrl(),
    `(async () => {
      const { Compiler } = await import("https://cdn.jsdelivr.net/npm/mind-ar@${MINDAR_VERSION}/dist/mindar-image.prod.js");
      const load = (src) => new Promise((resolve, reject) => {
        const image = new Image();
        image.onload = () => resolve(image);
        image.onerror = reject;
        image.src = src;
      });
      const compiler = new Compiler();
      await compiler.compileImageTargets(await Promise.all(${JSON.stringify(images)}.map(load)), () => {});
      const bytes = new Uint8Array(await compiler.exportData());
      let binary = "";
      for (let i = 0; i < bytes.length; i += 0x8000) binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
      return btoa(binary);
    })()`,
  );

  writeFileSync(
    OUT,
    `// Generated by scripts/compile-ar-targets.mts. Do not edit; run \`npm run ar:targets\`.
// Sources and licenses: src/ar/test-targets/README.md

/** Labels by target index, in the order the targets were compiled. */
export const testTargetLabels = ${JSON.stringify(TARGETS.map((target) => target.label))};

/** MindAR ${MINDAR_VERSION} \`.mind\` file, base64. */
export const testTargetsMind =
  "${mind}";
`,
  );
  console.log(`Wrote ${OUT} (${TARGETS.length} targets, ${Math.round((mind.length * 3) / 4 / 1024)} KB)`);
} finally {
  // Chrome writes to its profile until it has exited.
  const exited = new Promise((resolve) => chrome.once("exit", resolve));
  chrome.kill();
  await exited;
  rmSync(profile, { recursive: true, force: true, maxRetries: 5, retryDelay: 200 });
}
