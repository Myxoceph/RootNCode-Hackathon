# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored; never commit it.

# Required. Use letters and digits only (it goes into a connection URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Domain pointing at the server (gets HTTPS automatically), or ":80" for plain HTTP by IP.
SITE_ADDRESS=:80

# The address people open in the browser; the API allows it for CORS.
PUBLIC_URL=http://localhost

# Public base URL of the media: the media Worker in front of the R2 bucket (no trailing slash, docs/deploy.md).
MEDIA_BASE_URL=https://media.allbytech.com

# Only behind Cloudflare Tunnel, with HTTP_PORT=127.0.0.1:8080 (docs/deploy.md): private_ranges.
# TRUSTED_PROXIES=private_ranges

# Host ports Caddy listens on. Change only for a local trial next to other services.
HTTP_PORT=80
HTTPS_PORT=443
