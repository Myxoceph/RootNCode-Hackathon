# SITE_ADDRESS: a domain (e.g. vagabonds.example.com) gets automatic HTTPS from Let's Encrypt;
# ":80" serves plain HTTP on any host name or IP (no certificate).

{
	servers {
		# Behind Cloudflare Tunnel (docs/deploy.md) every request arrives from cloudflared on a
		# private address; trust it for the visitor's IP, so the API's rate limit counts visitors,
		# not the tunnel. A request from a public address is never trusted, so its headers are dropped.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
		-Server
	}

	# API: /api/assets → api:3000/assets. Swagger UI at /api/docs.
	handle_path /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:3000
	}

	# Web app (Expo static export). Hashed bundles are cached for a year.
	handle {
		root * /srv/web
		@hashed path /_expo/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Asset details are rendered in the browser from the API, so the export has one shell
		# page for all of them. Only one rewrite runs: a detail URL skips try_files below.
		@assetDetail path_regexp ^/monuments/[^/]+/?$
		rewrite @assetDetail "/monuments/[id].html"
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}
