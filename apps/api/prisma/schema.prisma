  id                     String   @id
  city_code              String
  sort_order             Int      @db.SmallInt
  kind                   String
  name_tr                String
  name_en                String?
  description_tr         String
  description_en         String?
  story_tr               String?
  story_en               String?
  district               String?
  gi_portal_id           Int
  gi_registration_number String
  gi_registered_on       DateTime @db.Date
  gi_type                String
  gi_registrant          String
  gi_document_url        String
  source_id              String
  source_url             String?
  confidence             String
  status                 String
  city                   city     @relation(fields: [city_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  source                 source   @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([city_code, sort_order], map: "city_dish_city_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sound {
  key              String  @id
  sort_order       Int     @db.SmallInt
  title_tr         String
  title_en         String?
  file_key         String
  duration_seconds Float   @db.Real
  captions         Json    @default("[]")
  license          String
  author           String?
  source_url       String
