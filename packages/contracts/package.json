{
  "name": "@vagabonds/contracts",
  "version": "0.2.1",
  "private": true,
  "description": "Shared API data contract (Zod schemas and TypeScript types) between the Vagabonds backend and client.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mock/mock_monuments.json": "./mock/mock_monuments.json"
  },
  "scripts": {
