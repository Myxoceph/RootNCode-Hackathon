{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kok-kod.local/schema/sound.schema.json",
  "title": "Ortam sesleri",
  "description": "Sesli Zaman Kapsülü'nün (modül 7) kayıtları: sounds.json. Ses dosyası medya bucket'ında `file` yolundadır; anahtar eserlerin ambient_sound.sound_key ya da enums.json → asset_types.ambient_sound değeridir. Çapraz kontroller tools/validate.py'de.",
  "type": "object",
  "required": ["schema_version", "sounds"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "_aciklama": { "type": "string" },
    "sounds": { "type": "array", "items": { "$ref": "#/$defs/sound" } }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": ["tr", "en"],
      "additionalProperties": false,
      "properties": {
        "tr": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "sound": {
      "type": "object",
      "required": ["key", "title", "file", "duration_seconds", "captions", "license", "author", "source_url", "status"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$", "description": "ör. hamam, cami-sadirvan" },
        "title": { "$ref": "#/$defs/text" },
        "file": {
          "type": "string",
          "pattern": "^sounds/[a-z]+(-[a-z]+)*\\.(mp3|m4a)$",
          "description": "Bucket'taki yol: sounds/<key>.mp3 (24–25 sn, mono)"
        },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "captions": {
          "type": "array",
          "minItems": 1,
          "description": "Altyazı: her ses olayı köşeli parantez içinde bir satır; `at` saniye, artan sırada",
          "items": {
            "type": "object",
            "required": ["at", "text"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "number", "minimum": 0 },
              "text": { "$ref": "#/$defs/text" }
            }
          }
        },
        "license": { "enum": ["CC0-1.0", "CC-BY-4.0"], "description": "CC-BY'de author zorunludur" },
        "author": { "type": ["string", "null"], "description": "Kaydı yapan; CC0'da da biliniyorsa yazılır" },
        "source_url": { "type": "string", "format": "uri", "description": "Kaydın alındığı sayfa (ör. freesound.org/s/<id>/)" },
        "status": { "enum": ["draft", "in_review", "published"] }
      }
    }
  }
}
